rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'babalumokase@gmail.com' && request.auth.token.email_verified == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().uid == userId;
      allow update: if isOwner(userId) && incoming().uid == userId;
      allow delete: if isOwner(userId) || isAdmin();

      // User subcollection for download history & bookmarks
      match /history/{historyId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(historyId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(historyId) && incoming().userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Public / Aggregated Statistics for system status and admin dashboard
    match /stats/{statDoc} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // DMCA and Content issue reports
    match /reports/{reportId} {
      allow create: if isValidId(reportId);
      allow read, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
